# Banco: a aplicação conecta como clinica_app (sem BYPASSRLS); migrations como clinica_dono.
DATABASE_URL=postgres://clinica_app:app_local@localhost:5432/clinica
DATABASE_URL_DONO=postgres://clinica_dono:dono_local@localhost:5432/clinica
PORT=4020
# Base pública do backend; cada organização fica em {BASE}/o/{slug} (urlApi).
URL_PUBLICA=http://localhost:4020
# Chaves (geradas por `pnpm chaves`). Obrigatórias em produção, num cofre; em dev, efêmeras.
CHAVE_JWT_PRIVADA=
# Rotação: a chave anterior (PEM) continua aceita na verificação até os tokens dela expirarem (15 min).
# CHAVE_JWT_ANTERIOR=
CHAVE_CIFRA=
SEGREDO_ASSINATURA=
# Storage: local (disco + URLs assinadas pelo próprio backend) ou s3 (AWS S3, MinIO...).
STORAGE=local
STORAGE_DIR=./.dados/arquivos
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=clinica
# S3_REGIAO=us-east-1
# E-mail: log (só registra, sem conteúdo), arquivo (.dados/emails.jsonl, só dev) ou smtp.
EMAIL=log
# SMTP_URL=smtp://usuario:senha@smtp.provedor.com:587   (Mailpit local: smtp://localhost:1025)
# EMAIL_REMETENTE=nao-responda@clinica.com.br
# Web Push (gere com `pnpm chaves`). Sem as duas chaves o manifesto anuncia push NENHUM.
# VAPID_CHAVE_PUBLICA=
# VAPID_CHAVE_PRIVADA=
# VAPID_ASSUNTO=mailto:suporte@clinica.com.br
# Jobs (14.3): o worker roda no mesmo processo da API. JOBS=0 numa instância só de API.
# JOBS=1
# JOBS_INTERVALO_MS=2000
# Seed (org:criar): a linha do tempo dos cenários é deslocada para hoje; 0 mantém as datas absolutas.
# CENARIO_DESLOCAR=1
# Só em ambiente de teste: código por e-mail fixo e TOTP fixo, para a suíte de conformidade.
# MODO_TESTE_CODIGO_EMAIL=123456
# MODO_TESTE_TOTP=000000
# Valida cada resposta contra o contrato (500 + X-Violacao-Contrato se violar). Ligado em dev/CI.
# VALIDAR_RESPOSTA=1
# LOG_LEVEL=info
# Limite de requisições por minuto (por instância): 429 MUITAS_TENTATIVAS acima disso.
# LIMITE_IP_POR_MIN=1200
# LIMITE_CONTA_POR_MIN=600
# LIMITE_ORG_POR_MIN=6000
# Antivírus para PDF de exame (ADR-0017): tcp://host:3310 (clamd) ou "teste" (EICAR; fora de produção).
# ANTIVIRUS_URL=teste
# Assinatura de documentos (ADR-0018): PSC simulado (fora de produção) ou PSC reais cadastrados (API do ITI).
# PSC_TESTE=1
# PSC_PROVEDORES=[{"id":"birdid","nome":"BirdID","base":"https://...","clientId":"...","clientSecret":"..."}]
