# Alvo: diretório (resolve urlApi pelo slug) ou urlApi direto.
CONF_DIRETORIO_URL=http://localhost:4010/diretorio
CONF_SLUG=modelo-otorrino
# CONF_URL_API=http://localhost:4010/o/modelo-otorrino

# Só para o mock: reinicia o estado antes da suíte (rotas /__mock não fazem parte do contrato).
CONF_ANTES_URL=http://localhost:4010/__mock/reiniciar

# Gestor (precisa também do perfil PROFISSIONAL ou de outra conta em CONF_PROFISSIONAL_*).
CONF_GESTOR_EMAIL=ana@modelo-otorrino.exemplo
CONF_GESTOR_SENHA=Senha@12345
CONF_GESTOR_TOTP=JBSWY3DPEHPK3PXP

# Paciente com conta ativa, usado no login por código. O backend de teste deve aceitar um código fixo.
CONF_PACIENTE_EMAIL=marcos@exemplo.com
CONF_CODIGO_EMAIL=123456

# Opcional: conta de primeiro acesso (TROCAR_SENHA → CONFIGURAR_MFA → ACEITAR_TERMOS). Consumida a cada execução.
CONF_PRIMEIRO_ACESSO_EMAIL=carlos@modelo-otorrino.exemplo
CONF_PRIMEIRO_ACESSO_SENHA=Provisoria@1
