{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exemplo.com.br/contrato/v1/configuracao-publica.schema.json",
  "title": "Configuração pública (GET /v1/publico/configuracao)",
  "x-gerado-de": "contrato/openapi.yaml#/$defs/ConfiguracaoPublica (1.0.0-rc.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato",
    "status",
    "mensagemStatus",
    "frontend",
    "organizacao",
    "tema",
    "pwa",
    "autenticacao",
    "textos",
    "links"
  ],
  "properties": {
    "contrato": {
      "$ref": "#/$defs/Contrato"
    },
    "status": {
      "$ref": "#/$defs/StatusOrganizacao"
    },
    "mensagemStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versaoMinima"
      ],
      "properties": {
        "versaoMinima": {
          "$ref": "#/$defs/Versao"
        }
      }
    },
    "organizacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "nome",
        "fuso",
        "locale"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/Slug"
        },
        "nome": {
          "type": "string"
        },
        "fuso": {
          "type": "string",
          "description": "IANA",
          "examples": [
            "America/Sao_Paulo"
          ]
        },
        "locale": {
          "type": "string",
          "examples": [
            "pt-BR"
          ]
        }
      }
    },
    "tema": {
      "$ref": "#/$defs/Tema"
    },
    "pwa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "nomeCurto",
        "corTema",
        "icones"
      ],
      "properties": {
        "nome": {
          "type": "string"
        },
        "nomeCurto": {
          "type": "string",
          "maxLength": 12
        },
        "corTema": {
          "$ref": "#/$defs/Cor"
        },
        "icones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "tamanho"
            ],
            "properties": {
              "src": {
                "type": "string",
                "format": "uri"
              },
              "tamanho": {
                "type": "string",
                "pattern": "^[0-9]+x[0-9]+$"
              },
              "proposito": {
                "type": "string",
                "enum": [
                  "any",
                  "maskable"
                ],
                "x-catalogo-nomes": true
              }
            }
          }
        }
      }
    },
    "autenticacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metodos",
        "cadastroPaciente",
        "termosVersao"
      ],
      "properties": {
        "metodos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "publico"
            ],
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "SENHA",
                  "CODIGO_EMAIL"
                ]
              },
              "publico": {
                "type": "string",
                "enum": [
                  "EQUIPE",
                  "PACIENTE"
                ]
              },
              "mfa": {
                "type": "string",
                "enum": [
                  "OBRIGATORIO",
                  "OPCIONAL"
                ]
              }
            }
          }
        },
        "cadastroPaciente": {
          "type": "string",
          "enum": [
            "SOMENTE_CONVITE",
            "ABERTO"
          ]
        },
        "termosVersao": {
          "type": "string",
          "description": "Versão vigente dos termos",
          "enviada no aceite.": null
        }
      }
    },
    "textos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boasVindasTitulo",
        "boasVindasTexto"
      ],
      "properties": {
        "boasVindasTitulo": {
          "type": "string"
        },
        "boasVindasTexto": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termosDeUso",
        "privacidade",
        "suporte"
      ],
      "properties": {
        "termosDeUso": {
          "type": "string",
          "format": "uri"
        },
        "privacidade": {
          "type": "string",
          "format": "uri"
        },
        "suporte": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "$defs": {
    "Contrato": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versao"
      ],
      "properties": {
        "versao": {
          "$ref": "#/$defs/Versao"
        }
      }
    },
    "Versao": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"
    },
    "StatusOrganizacao": {
      "type": "string",
      "enum": [
        "ATIVA",
        "MANUTENCAO",
        "SUSPENSA"
      ]
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 63
    },
    "Tema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corMarca",
        "logoUrl",
        "logoEscuroUrl",
        "modoPadrao"
      ],
      "properties": {
        "corMarca": {
          "$ref": "#/$defs/Cor"
        },
        "logoUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "logoEscuroUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "modoPadrao": {
          "type": "string",
          "enum": [
            "CLARO",
            "ESCURO",
            "SISTEMA"
          ]
        }
      }
    },
    "Cor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
