          ],
          "description": "Comentário de quem enviou."
        },
        "origem": {
          "type": "string",
          "enum": [
            "PACIENTE",
            "EQUIPE"
          ]
        },
        "enviadoPor": {
          "$ref": "#/$defs/ReferenciaUsuario"
        },
        "status": {
