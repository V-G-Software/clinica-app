        "historico": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventoAgendamento"
          }
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "acoesPermitidas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EDITAR",
              "CONFIRMAR",
              "CANCELAR",
              "REMARCAR",
              "REALIZAR",
              "REGISTRAR_FALTA",
              "ABRIR_CONVERSA"
            ]
          }
        }
      }
    },
    "CategoriaServico": {
      "type": "string",
      "enum": [
        "CONSULTA",
        "PROCEDIMENTO"
      ]
    },
    "StatusAgendamento": {
      "type": "string",
      "enum": [
        "AGENDADO",
        "CONFIRMADO",
        "REALIZADO",
        "CANCELADO",
        "FALTOU"
      ]
    },
    "EventoAgendamento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocorridoEm",
        "acao",
        "por"
      ],
      "properties": {
        "ocorridoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "acao": {
          "type": "string",
          "enum": [
            "CRIADO",
            "CONFIRMADO",
            "REMARCADO",
            "CANCELADO",
            "REALIZADO",
            "FALTOU"
          ]
        },
        "por": {
          "oneOf": [
            {
              "$ref": "#/$defs/ReferenciaUsuario"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` = ação automática."
        },
        "detalhe": {
          "type": [
            "string",
            "null"
          ],
          "description": "Motivo do cancelamento ou da remarcação."
        }
      }
    },
    "AgendamentoResumo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inicioEm",
        "fimEm",
        "status",
        "servico",
        "profissional",
        "paciente"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "inicioEm": {
          "$ref": "#/$defs/DataHora"
        },
        "fimEm": {
          "$ref": "#/$defs/DataHora"
        },
        "status": {
          "$ref": "#/$defs/StatusAgendamento"
        },
        "servico": {
          "type": "object",
