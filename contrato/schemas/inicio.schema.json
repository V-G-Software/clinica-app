                  "$ref": "#/$defs/DataHora"
                },
                "nota": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Visível ao paciente."
                }
              }
            }
          ]
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "acoesPermitidas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "REVISAR"
            ]
          }
        }
      }
    },
    "Arquivo": {
      "type": "object",
