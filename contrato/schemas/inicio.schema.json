    "FinalidadeArquivo": {
      "type": "string",
      "enum": [
        "CHECKIN",
        "CHAT",
        "PERFIL",
        "ORGANIZACAO",
        "EXAME",
        "DOCUMENTO"
      ],
      "description": "`DOCUMENTO` só o servidor cria (PDF assinado, ADR-0018); `POST /v1/arquivos` com ela → 422."
    },
    "StatusResultadoExame": {
      "type": "string",
      "enum": [
        "AGUARDANDO_REVISAO",
        "REVISADO"
      ]
    },
    "Documento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "paciente",
        "emissor",
        "registro",
        "status",
        "receita",
        "atestado",
        "arquivo",
        "codigoValidacao",
        "entrega",
        "motivoAnulacao",
        "erroAssinatura",
        "criadoEm",
        "assinadoEm",
        "anuladoEm",
        "acoesPermitidas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "tipo": {
          "$ref": "#/$defs/TipoDocumento"
        },
        "paciente": {
          "$ref": "#/$defs/Referencia"
        },
        "emissor": {
          "$ref": "#/$defs/ReferenciaUsuario"
        },
        "registro": {
          "$ref": "#/$defs/RegistroProfissional",
          "description": "Registro do emissor no momento da emissão (impresso no PDF)."
        },
        "status": {
          "$ref": "#/$defs/StatusDocumento"
        },
        "receita": {
          "oneOf": [
            {
              "$ref": "#/$defs/ConteudoReceita"
            },
            {
              "type": "null"
            }
          ]
        },
        "atestado": {
          "oneOf": [
            {
              "$ref": "#/$defs/ConteudoAtestado"
            },
            {
              "type": "null"
            }
          ]
        },
        "arquivo": {
          "oneOf": [
            {
              "$ref": "#/$defs/Arquivo"
            },
            {
              "type": "null"
            }
          ],
          "description": "PDF assinado (finalidade `DOCUMENTO`), só em `ASSINADO` e `ANULADO`."
        },
        "codigoValidacao": {
          "type": [
            "string",
            "null"
          ],
          "description": "Código da validação pública (`/v1/publico/documentos/{codigo}`), só depois de assinado."
        },
        "entrega": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "conversaId",
                "mensagemId",
                "entregueEm"
              ],
              "properties": {
                "conversaId": {
                  "$ref": "#/$defs/Id"
                },
                "mensagemId": {
                  "$ref": "#/$defs/Id"
                },
                "entregueEm": {
                  "$ref": "#/$defs/DataHora"
                }
              }
            }
          ],
          "description": "Mensagem do chat que levou o documento ao paciente (nula sem o chat ou com `entregarPeloChat` desligado)."
        },
        "motivoAnulacao": {
          "type": [
            "string",
            "null"
          ]
        },
        "erroAssinatura": {
          "type": [
            "string",
            "null"
          ],
          "description": "Motivo da última tentativa de assinatura que falhou (o rascunho volta a `RASCUNHO`)."
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "assinadoEm": {
          "$ref": "#/$defs/DataHoraOuNulo"
        },
        "anuladoEm": {
          "$ref": "#/$defs/DataHoraOuNulo"
        },
        "acoesPermitidas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EDITAR",
              "DESCARTAR",
              "ASSINAR",
              "ANULAR"
            ]
          }
        }
      }
    },
    "TipoDocumento": {
      "type": "string",
      "enum": [
        "RECEITA",
        "ATESTADO"
      ]
    },
    "RegistroProfissional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conselho",
        "numero",
        "uf"
      ],
      "properties": {
        "conselho": {
          "type": "string",
          "examples": [
            "CRM",
            "CRMV"
          ]
        },
        "numero": {
          "type": "string"
        },
        "uf": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "StatusDocumento": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "ASSINANDO",
        "ASSINADO",
        "DESCARTADO",
        "ANULADO"
      ]
    },
    "ConteudoReceita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itens"
      ],
      "description": "Receita simples. Controle especial (Portaria 344/98) e antimicrobianos ficam fora do app.",
      "properties": {
        "itens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "medicamento",
              "posologia"
            ],
            "properties": {
              "medicamento": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200,
                "description": "Nome, concentração e forma (por exemplo, \"Amoxicilina 500 mg, cápsula\")."
              },
              "posologia": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500
              },
              "quantidade": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100,
                "description": "Por exemplo, \"1 caixa\" ou \"21 cápsulas\"."
              }
            }
          }
        },
        "orientacoes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "ConteudoAtestado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalidade",
        "data"
      ],
      "description": "AFASTAMENTO exige `dias`; COMPARECIMENTO exige `horaInicio` e `horaFim`. `cid` só com\n`cidAutorizado: true` (autorização expressa do paciente; CFM 1.658/2002), senão 422.\n",
      "properties": {
        "modalidade": {
          "type": "string",
          "enum": [
            "AFASTAMENTO",
            "COMPARECIMENTO"
          ]
        },
        "data": {
          "$ref": "#/$defs/Data",
          "description": "Início do afastamento ou dia do comparecimento."
        },
        "dias": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 365
        },
        "horaInicio": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "horaFim": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "cid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][0-9]{2}(\\.[0-9]{1,2})?$"
        },
        "cidAutorizado": {
          "type": "boolean",
          "default": false
        },
        "observacoes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "PedidoExame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paciente",
        "solicitante",
        "itens",
        "orientacoes",
        "observacao",
        "status",
        "motivoCancelamento",
        "resultados",
        "criadoEm",
        "concluidoEm",
        "acoesPermitidas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "paciente": {
          "$ref": "#/$defs/Referencia"
        },
        "solicitante": {
          "$ref": "#/$defs/ReferenciaUsuario"
        },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nome",
              "orientacoes"
            ],
            "properties": {
              "nome": {
                "type": "string"
              },
              "orientacoes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "orientacoes": {
          "type": [
            "string",
            "null"
          ]
        },
        "observacao": {
          "type": [
            "string",
            "null"
          ],
          "description": "Interna da equipe; sempre `null` para o paciente."
        },
        "status": {
          "$ref": "#/$defs/StatusPedidoExame"
        },
        "motivoCancelamento": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultados": {
          "type": "array",
          "description": "Resultados ligados ao pedido, do mais antigo para o mais recente.",
          "items": {
            "$ref": "#/$defs/ResultadoExameResumo"
          }
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "concluidoEm": {
          "$ref": "#/$defs/DataHoraOuNulo"
        },
        "acoesPermitidas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ENVIAR_RESULTADO",
              "CONCLUIR",
              "CANCELAR"
            ]
          }
        }
      }
    },
    "StatusPedidoExame": {
      "type": "string",
      "enum": [
        "ABERTO",
        "CONCLUIDO",
        "CANCELADO"
      ]
    },
    "ResultadoExameResumo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo",
        "status",
        "criadoEm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "titulo": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StatusResultadoExame"
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        }
      }
    }
  }
}
