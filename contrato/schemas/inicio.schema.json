        "comentario",
        "origem",
        "enviadoPor",
        "status",
        "revisao",
        "criadoEm",
        "acoesPermitidas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "paciente": {
          "$ref": "#/$defs/Referencia"
        },
        "pedidoId": {
          "$ref": "#/$defs/IdOuNulo"
        },
        "titulo": {
          "type": "string"
        },
        "dataColeta": {
          "oneOf": [
            {
              "$ref": "#/$defs/Data"
            },
            {
