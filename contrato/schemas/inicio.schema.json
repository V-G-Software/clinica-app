        "encaixe": {
          "type": "boolean"
        },
        "local": {
          "type": [
            "string",
            "null"
          ]
        },
        "orientacoes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Preparo copiado do serviço na hora da marcação."
        },
        "observacao": {
          "type": [
            "string",
            "null"
          ],
          "description": "Interna da equipe; sempre `null` para o paciente."
        },
        "motivoCancelamento": {
          "type": [
            "string",
            "null"
          ]
        },
        "acompanhamentoId": {
          "$ref": "#/$defs/IdOuNulo",
