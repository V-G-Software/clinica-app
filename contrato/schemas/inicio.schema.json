          "$ref": "#/$defs/ReferenciaUsuario"
        },
        "servico": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "nome",
            "categoria"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "nome": {
              "type": "string"
            },
            "categoria": {
              "$ref": "#/$defs/CategoriaServico"
            }
          }
        },
        "inicioEm": {
          "$ref": "#/$defs/DataHora"
        },
        "fimEm": {
          "$ref": "#/$defs/DataHora"
        },
        "status": {
          "$ref": "#/$defs/StatusAgendamento"
        },
        "origem": {
          "type": "string",
          "enum": [
            "EQUIPE",
            "PACIENTE"
          ]
