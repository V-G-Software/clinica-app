          "type": [
            "string",
            "null"
          ]
        },
        "urlVisualizacao": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "urlMiniatura": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "urlsExpiramEm": {
          "$ref": "#/$defs/DataHoraOuNulo"
        },
        "criadoEm": {
          "$ref": "#/$defs/DataHora"
        }
      }
