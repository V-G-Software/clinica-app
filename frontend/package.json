{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "node e2e/fe0.mjs && node e2e/fe1.mjs && node e2e/fe2.mjs && node e2e/fe3.mjs && node e2e/fe4.mjs",
    "e2e:a11y": "node e2e/acessibilidade.mjs",
    "build:homologacao": "vite build --mode homologacao",
    "preview:homologacao": "vite preview --mode homologacao --port 4173 --strictPort",
    "e2e:csp": "node e2e/csp.mjs"
  },
  "dependencies": {
    "@clinica/contrato-cliente": "workspace:*",
    "@clinica/contrato-tipos": "workspace:*",
    "@tanstack/vue-query": "^5.80.0",
    "lucide-vue-next": "^0.511.0",
    "openapi-fetch": "^0.14.0",
    "pinia": "^3.0.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.3.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
